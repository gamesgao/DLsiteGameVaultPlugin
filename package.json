{
  "name": "dlsite-gamevault-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "DLsite metadata core for a native GameVault provider (in development)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "smoke:dlsite": "node scripts/smoke-dlsite.mjs",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/*.mjs\" \"*.json\" vitest.config.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/*.mjs\" \"*.json\" vitest.config.ts"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "turndown": "7.2.4"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/turndown": "5.0.6",
    "@vitest/coverage-v8": "5.0.5",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
